<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>IliadBar</string>
	<key>CFBundleDisplayName</key>
	<string>IliadBar</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>it</string>
	<key>CFBundleLocalizations</key>
	<array><string>it</string><string>en</string></array>
	<key>CFBundleIdentifier</key>
	<string>it.ivansposato.iliadbar</string>
	<key>CFBundleVersion</key>
	<string>__ILIADBAR_VERSION__</string>
	<key>CFBundleShortVersionString</key>
	<string>__ILIADBAR_VERSION__</string>
	<key>CFBundleExecutable</key>
	<string>IliadBar</string>
	<key>IliadBarAppGroup</key>
	<string>__ILIADBAR_APP_GROUP__</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- Solo menu bar: niente icona nel Dock -->
	<key>LSUIElement</key>
	<true/>
	<!-- Handler dello schema magnet: -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Magnet Link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>magnet</string>
			</array>
		</dict>
	</array>
	<!-- Gli endpoint configurabili includono HTTP LAN e HTTPS con CA privata.
	     L'eccezione è limitata ai domini iliadbox; BoxTrustDelegate continua a
	     imporre hostname, validità della catena e pin della CA. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>ibxos.it</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>IliadBar comunica con la iliadbox sulla rete locale.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_fbx-api._tcp</string>
	</array>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://github.com/giveme11us/IliadBar/releases/latest/download/appcast.xml</string>
</dict>
</plist>
